<% if (typeof editMode !== 'undefined' && editMode) { %>
<!-- Edit Mode -->
<div class="alert alert-info mb-4">Editing Post</div>
<form action="/edit/<%= post.id %>" method="POST">
  <div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input
      type="text"
      class="form-control"
      id="title"
      name="title"
      value="<%= post.title %>"
      required
    />
  </div>
  <div class="mb-3">
    <label for="content" class="form-label">Content</label>
    <textarea
      class="form-control"
      id="content"
      name="content"
      rows="10"
      required
    >
<%= post.content %></textarea
    >
  </div>
  <button type="submit" class="btn btn-success">Save Changes</button>
  <a href="/post/<%= post.id %>" class="btn btn-secondary">Cancel</a>
</form>
<% } else { %>
<!-- View Mode -->
<article class="mb-5">
  <h1 class="mb-3"><%= post.title %></h1>
  <p class="text-muted mb-4">
    Published on: <%= new Date().toLocaleDateString() %>
  </p>
  <hr class="border-secondary my-4" />
  <div class="post-content">
    <% post.content.split('\n').forEach(paragraph => { %>
    <p class="mb-3"><%= paragraph %></p>
    <% }); %>
  </div>
</article>

<div class="d-flex gap-2 mb-5">
  <a href="/edit/<%= post.id %>" class="btn btn-primary">Edit</a>
  <a
    href="/delete/<%= post.id %>"
    class="btn btn-danger"
    onclick="return confirm('Are you sure you want to delete this post?');"
  >
    Delete
  </a>

  <a href="/blog" class="btn btn-secondary ms-auto">← Back to Blog</a>
</div>
<% } %>
